<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="TerraTrack" xmlns="http://www.topografix.com/GPX/1/1">
<wpt lat="40.013886" lon="-105.294812"><name>Coffee: Boulder</name><desc>Mile 0. Fill up and have coffee before you go.</desc></wpt>
<wpt lat="39.864772" lon="-105.466032"><name>Fuel: Shell</name><desc>Mile 21.1.</desc></wpt>
<wpt lat="39.743403" lon="-105.513822"><name>Coffee: Idaho Springs</name><desc>Mile 39. The Frothy Cup, 1510 Miner, from 7. Fuel: 13th and Miner.</desc></wpt>
<wpt lat="39.632235" lon="-105.323799"><name>Fuel: Evergreen</name><desc>Mile 58.3. Coffee: EverBean, 29003 Upper Bear Creek, 6 to 4; Muddy Buck, 28065 CO 74, from 7.</desc></wpt>
<wpt lat="39.520129" lon="-105.306616"><name>Fuel: Conifer. LAST ON THE LINE FOR 127 MILES</name><desc>Mile 72.2. Florissant is 4.6 mi off the line at Lake George.</desc></wpt>
<wpt lat="39.158042" lon="-105.164014"><name>Way out: Right onto Westcreek Road (CR 73)</name><desc>Mile 109.1. Trail Creek wet? Stay on CO 67 to Woodland Park, US 24 to Lake George: 34 mi, paved; fuel on the way.</desc></wpt>
<wpt lat="39.009343" lon="-105.277223"><name>Check: Right onto Trail Creek Road (County 32)</name><desc>Mile 122.8. Two gates are mapped toward Lake George: pass and leave as found, or turn back.</desc></wpt>
<wpt lat="38.978825" lon="-105.356335"><name>Lunch: Lake George (right on US 24)</name><desc>Mile 129. Gold Water Cafe, 38283 US 24, 6 to 4, closed Mon (hours not confirmed). Two other places in town closed in 2026: call it plan A, sandwiches plan B.</desc></wpt>
<wpt lat="38.984760" lon="-105.361469"><name>Fuel: Low? Florissant, 4.6 mi EAST on US 24</name><desc>Mile 129.5. Sinclair and Conoco. 71 miles to Salida from here. A store in Lake George may sell fuel: not confirmed.</desc></wpt>
<wpt lat="38.982937" lon="-105.574572"><name>Way out: DECIDE: left onto CR 59</name><desc>Mile 145.2. Wet, or low on fuel? CR 59 the other way to US 24, then Salida: 64 mi, nearly all paved.</desc></wpt>
<wpt lat="38.935162" lon="-105.593661"><name>Rough: Right onto County Road 118</name><desc>Mile 149.8. Unimproved. Mud holds you here.</desc></wpt>
<wpt lat="38.869955" lon="-105.604871"><name>Rough: Left, then right onto Union Road (FR 270)</name><desc>Mile 155. Easy but chunky rock. Right at 155.5.</desc></wpt>
<wpt lat="38.849078" lon="-105.643041"><name>Way out: CO 9</name><desc>Mile 158.5. WET? Skip Parker Road: CO 9 north, US 24, US 285 to Salida, 63 mi, paved.</desc></wpt>
<wpt lat="38.846989" lon="-105.646713"><name>Rough: Parker Road (FR 108)</name><desc>Mile 158.7. High clearance, ruts; slick clay when wet.</desc></wpt>
<wpt lat="38.542062" lon="-106.000193"><name>Fuel: Conoco, 337 W 1st, Salida</name><desc>Mile 199.4. On CO 291, a quarter mile past the end of the line.</desc></wpt>
